NOTION_API_KEY=
NOTION_TERMS_DATA_SOURCE_ID=
NOTION_SERIES_DATA_SOURCE_ID=
NOTION_PEOPLE_DATA_SOURCE_ID=
NOTION_COMMITTEE_ROLES_DATA_SOURCE_ID=
NOTION_EVENTS_DATA_SOURCE_ID=
NOTION_MEDIA_DATA_SOURCE_ID=
NOTION_ARTICLES_DATA_SOURCE_ID=
NOTION_REGISTRATION_DATA_SOURCE_ID=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Filebase S3-compatible audio storage (server-only; never use NEXT_PUBLIC_)
FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
FILEBASE_BUCKET=taize-audio
# Optional override; this is the official default.
FILEBASE_ENDPOINT=https://s3.filebase.io

# Temporary compatibility for deployments created before the activity-centered
# data model. New deployments should use NOTION_ARTICLES_DATA_SOURCE_ID above.
NOTION_DATABASE_ID=

# Your production/staging URL (no trailing slash).
# Used as the emailRedirectTo base for Supabase auth emails.
# Must also be added to: Supabase Dashboard → Auth → URL Configuration → Redirect URLs
NEXT_PUBLIC_SITE_URL=https://your-domain.com
